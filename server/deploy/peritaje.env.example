# Copiar a /etc/peritaje/peritaje.env y dar permisos 640 (lo hace install.sh).
# Nunca subir este archivo relleno a git.

# Token de la integración interna de Notion (https://www.notion.so/my-integrations).
# La integración debe tener acceso a la página "Gestión de Encargos - Peritaciones".
NOTION_TOKEN=

# Token compartido con la app del móvil. Generar con:  openssl rand -hex 32
APP_TOKEN=

# Bases de datos de Notion (ya rellenas con las de tu workspace).
NOTION_DB_ENCARGOS=7a39eda7868548fcbee05234305a9bd1
NOTION_DB_VISITAS=8c1aacdbae3e48bcbe88f41545450e66
NOTION_DB_CONTACTOS=e7352915ceb2400b8538aa822de2f6b0

# Ventana del índice de visitas: desde ayer hasta mañana. El móvil solo carga hoy
# (y mañana a partir de las 17:00); las pendientes de cierre las sigue por su cuenta.
# Ampliarla solo hace más lenta cada sincronización (una lectura de Notion por encargo).
DIAS_ATRAS=1
DIAS_ADELANTE=1
ZONA_HORARIA=Europe/Madrid

# Título exacto del bloque donde se escribe el avance.
TITULO_AVANCE=AVANCE APP
ESTADOS_EXCLUIDOS=ANULADO,PNDT ANULADO
DIR_DATOS=/var/lib/peritaje

# Google Drive (subida de fotos). Lo rellena solo el asistente:
#   cd /opt/peritaje/server && sudo .venv/bin/python -m app.autorizar_drive
# Sin estas tres líneas el PC funciona igual, pero no acepta fotos.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Carpeta raíz de los expedientes en Drive (se busca por nombre en "Mi unidad").
DRIVE_NOMBRE_RAIZ=Expedientes_2026
